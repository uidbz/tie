# tie-daemon configuration
#
# Copy to tie-daemon.toml (or pass -config <path>) and edit.
# Access management is done here: add or remove [[Users]] entries.
# Passwords are stored in plaintext, so keep this file readable only by the
# daemon's user (e.g. chmod 600).

ListenOn = ":1161"
DbPath = "/data"

# TLS is normally terminated by a reverse proxy: run Insecure and bind ListenOn
# to localhost, or point CertFile/KeyFile at a cert pair to serve HTTPS directly.
Insecure = false
CertFile = ""
KeyFile = ""

# Logging. Records are always pretty-printed to stderr; set LogFile to also
# append structured JSON to a file. LogLevel is debug, info, warn, or error.
LogFile = ""
LogLevel = "info"

[[Users]]
Username = "defaultuser"
Password = "defaultpassword"
