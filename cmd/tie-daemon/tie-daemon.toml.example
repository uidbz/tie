# tie-daemon configuration
#
# Copy to tie-daemon.toml (or pass -config <path>) and edit.
# Access management is done here: add or remove [[Users]] entries.
# Passwords are stored in plaintext, so keep this file readable only by the
# daemon's user (e.g. chmod 600).

ListenOn = ":1161"
DbPath = "/data"

# TLS: either point at a cert/key pair, enable certmagic, or run Insecure.
Insecure = false
CertFile = ""
KeyFile = ""
UseCertmagic = false
CertmagicHost = ""

[[Users]]
Username = "defaultuser"
Password = "defaultpassword"
