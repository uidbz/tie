# tie-daemon configuration
#
# Copy to tie-daemon.toml (or pass -config <path>) and edit.
# Access management is done here: add or remove [[Users]] entries.
# Passwords are stored in plaintext, so keep this file readable only by the
# daemon's user (e.g. chmod 600).

ListenOn = ":1161"
DbPath = "/data"

# Plain HTTP by default: the expected setup is a personal library on a single
# PC or a small trusted LAN, bound to localhost. To serve HTTPS directly, set
# Insecure = false and point CertFile/KeyFile at a cert pair; otherwise put a
# TLS-terminating reverse proxy in front and keep Insecure = true on localhost.
Insecure = true
CertFile = ""
KeyFile = ""

# Logging. Records are always pretty-printed to stderr; set LogFile to also
# append structured JSON to a file. LogLevel is debug, info, warn, or error.
LogFile = ""
LogLevel = "info"

# Role granted to a request with no valid credentials: "none" (require auth for
# everything, the default), "read" (allow anonymous queries but require a write
# user for changes), or "write" (fully open).
AnonymousAccess = "none"

[[Users]]
Username = "defaultuser"
Password = "defaultpassword"
# Role is "write" (full read+write, the default when omitted) or "read"
# (queries only: Query/Expand/Associated/CoTags/Dump). Write covers Add, Delete,
# Set, Update, Batch, Sync, and Drop.
Role = "write"
