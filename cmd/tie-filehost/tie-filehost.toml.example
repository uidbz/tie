# tie-filehost configuration
#
# Copy to tie-filehost.toml (or pass -config <path>) and edit.

ListenOn = ":1162"
DbPath = "/data"

# How often expired blobs are reaped, as a Go duration (e.g. "1h", "30m").
# Empty or "0" disables the reaper (all blobs kept forever).
ReapInterval = "1h"

# TLS is normally terminated by a reverse proxy in front of the filehost:
# run Insecure and bind ListenOn to localhost (e.g. "127.0.0.1:1162").
# Alternatively, set CertFile/KeyFile to serve HTTPS directly.
Insecure = false
CertFile = ""
KeyFile = ""

# Logging. Records are always pretty-printed to stderr; set LogFile to also
# append structured JSON to a file. LogLevel is debug, info, warn, or error.
LogFile = ""
LogLevel = "info"
