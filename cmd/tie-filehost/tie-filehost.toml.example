# tie-filehost configuration
#
# Copy to tie-filehost.toml (or pass -config <path>) and edit.
#
# TOML note: every key after a [[table]] header belongs to that table until the
# next header, so all plain key = value settings must stay ABOVE the [[Users]]
# and [[BlobPaths]] sections at the bottom of this file. A key like
# Insecure = true placed below [[BlobPaths]] is silently read as part of that
# store entry and has no effect.

ListenOn = ":1162"

# Single-store setup: one physical blob directory. Deprecated in favor of
# BlobPaths (see the bottom of this file), but still supported — when BlobPaths
# is omitted a single "default" store is synthesized from BlobPath (permanent
# retention).
BlobPath = "/data"

# How often expired blobs are reaped, as a Go duration (e.g. "1h", "30m").
# Empty or "0" disables the reaper (all blobs kept forever).
ReapInterval = "1h"

# Plain HTTP by default: the expected setup is a personal library on a single
# PC or a small trusted LAN, bound to localhost. To serve HTTPS directly, set
# Insecure = false and point CertFile/KeyFile at a cert pair; otherwise put a
# TLS-terminating reverse proxy in front and keep Insecure = true on localhost.
Insecure = true
CertFile = ""
KeyFile = ""

# Logging. Records are always pretty-printed to stderr; set LogFile to also
# append structured JSON to a file. LogLevel is debug, info, warn, or error.
LogFile = ""
LogLevel = "info"

# Optional read cache on faster storage (e.g. SSD or tmpfs). On first access a
# blob is copied from BlobPath into CachePath and served from there on subsequent
# requests. An LRU eviction policy keeps total cache disk use near CacheSizeGB.
# Leave CachePath empty (the default) to serve all blobs directly from BlobPath.
#
# Example: cache on a tmpfs mounted at /mnt/ram
#   CachePath = "/mnt/ram/tie-cache"
#   CacheSizeGB = 4.0
CachePath = ""
CacheSizeGB = 1.0

# Authentication (HTTP Basic Auth). The filehost is fully open by default so
# unauthenticated uploads keep working. AnonymousAccess is the role granted to a
# request with no valid credentials:
#   "write" (the default): anyone may upload and download.
#   "read":  anonymous downloads are allowed, but uploads (and retention
#            changes) require a user with the "write" role.
#   "none":  every request requires a valid user.
# Passwords are stored in plaintext, so keep this file readable only by the
# filehost's user (e.g. chmod 600) once you add [[Users]].
#
# AnonymousAccess = "read"

# ---------------------------------------------------------------------------
# Table sections — must stay at the bottom (see TOML note at the top).

# [[Users]]
# Username = "alice"
# Password = "secret"
# Role = "write"   # "write" (upload+download) or "read" (download only)

# Multi-store setup: one filehost process, several named physical stores (e.g.
# fast SSD vs bulk HDD). Uploads route to a store by the Tie-Store header
# (empty targets the store named "default", else the first listed); reads search
# all stores by hash. Each store keeps its own retention index, so dedup is
# per-store. DefaultRetention applies to uploads to that store that carry no
# Tie-Retention header (a Go duration, or "infinite"/empty for permanent).
# When BlobPaths is set, BlobPath above is ignored.
#
# [[BlobPaths]]
# Name = "ssd"
# Path = "/mnt/ssd/blobs"
# DefaultRetention = "infinite"
#
# [[BlobPaths]]
# Name = "hdd"
# Path = "/mnt/hdd/blobs"
# DefaultRetention = "8760h"
